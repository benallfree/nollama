# Settings for the nollama service (https://github.com/benallfree/nollama).
# Then: sudo systemctl restart nollama

# Where it listens. 127.0.0.1 keeps it on this machine; 0.0.0.0 opens it to your network (it has no authentication).
NOLLAMA_HOST=127.0.0.1:11434

# Where models are downloaded.
NOLLAMA_MODELS=/var/lib/nollama/models

# Other `nollama serve` flags, such as: --threads 4 --parallel 2 --keep-alive -1s
SERVE_ARGS=
