# Settings for the nollama service (https://github.com/benallfree/nollama).
# Then: sudo systemctl restart nollama

# Where it listens. 127.0.0.1 keeps it on this machine; 0.0.0.0 opens it to your network, which needs an API key.
NOLLAMA_HOST=127.0.0.1:11434

# The key clients must send (Authorization: Bearer <key>). Required unless NOLLAMA_HOST is a loopback address.
# Make one with: openssl rand -hex 32
NOLLAMA_API_KEY=

# Where models are downloaded.
NOLLAMA_MODELS=/var/lib/nollama/models

# Other `nollama serve` flags, such as: --threads 4 --parallel 2 --keep-alive -1s --read-only --models qwen3-1.7b
SERVE_ARGS=
